---
import { getEmDashEntry, getSiteSettingsWithCacheHint } from "emdash";
import { currentStaffId, hubSettings } from "../staff/index.ts";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd, Image } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { THEME_SETTING_KEY, resolveTheme, themeById } from "../utils/theme";
import DailyBanner from "../components/DailyBanner.astro";
import { bannerSrc } from "../jobs/banner.ts";
import { bannerStore } from "../jobs/index.ts";
import { dhakaDay } from "../comics/store.ts";
import { displayName, initials } from "../utils/people";
import "../styles/theme.css";
import "../styles/themes.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Dashboard-width page (main column plus aside) instead of a reading column */
	wide?: boolean;
}

const { title, pageTitle, description, image, canonical, content, wide = false } =
	Astro.props;
const banner = bannerSrc(bannerStore(), dhakaDay(new Date()));
const NAV = [
	["/quiz", "Quiz"],
	["/people", "People"],
	["/gallery", "Gallery"],
	["/ideas", "Ideas"],
	["/handbook", "Handbook"],
	["/holidays", "Holidays"],
] as const;
const section = `/${Astro.url.pathname.split("/")[1]}`;
const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const themeId = resolveTheme(new Date(), hubSettings().get(THEME_SETTING_KEY));
const theme = themeById(themeId);

const staffId = currentStaffId(Astro.cookies);
// A person removed from People counts as signed out.
const staff = staffId ? (await getEmDashEntry("people", staffId)).entry : null;
const staffName = staff ? displayName(staff.data) : "";
const firstName = staffName.split(/\s+/)[0];

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en" data-theme={themeId}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{theme && <meta name="theme-color" content={theme.color} />}
		<title>{fullTitle}</title>
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-card-name" />
		<Font cssVariable="--font-card-script" />
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="site-header wrap wide">
			<div class="header-art"><DailyBanner src={banner} /></div>
			<a class="brand" href="/">
				{
					siteLogo ? (
						<img class="brand-logo" src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
					) : (
						<>
							<svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
								<circle cx="12" cy="12" r="11" fill="var(--accent)" />
								<circle cx="8.5" cy="8.5" r="3" fill="var(--accent-soft)" />
							</svg>
							<span>{siteTitle}</span>
						</>
					)
				}
			</a>
			<nav class="nav" aria-label="Main">
				{NAV.map(([href, label]) => (
					<a href={href} aria-current={section === href ? "page" : undefined}>
						{label}
					</a>
				))}
			</nav>
			{
				staff ? (
					<details class="who">
						<summary aria-label={`Signed in as ${staffName}. Account menu`}>
							{staff.data.photo ? (
								<Image image={staff.data.photo} alt="" width={32} height={32} class="who-avatar" />
							) : (
								<span class="who-avatar" aria-hidden="true">{initials(staffName)}</span>
							)}
							<span class="who-name">{firstName}</span>
							<svg class="who-caret" viewBox="0 0 12 12" aria-hidden="true">
								<path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<div class="who-menu">
							<p class="who-head">
								Signed in as <strong>{staffName}</strong>
							</p>
							<a href="/people/me">Edit my profile</a>
							<a href="/pin">Change PIN</a>
							<form method="post" action="/sign-out">
								<button type="submit">Not you? Sign out</button>
							</form>
						</div>
					</details>
				) : Astro.url.pathname === "/sign-in" ? null : (
					<a class="sign-in" href={`/sign-in?next=${encodeURIComponent(Astro.url.pathname)}`}>
						Sign in
					</a>
				)
			}
		</header>

		<main class:list={["wrap", { wide }]}>
			<slot />
		</main>

		<p class="theme-toast" role="status" hidden></p>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<script>
	// Secret: "t" previews the next colour theme, Shift+T the previous. Not saved; a reload restores today's.
	import { THEMES } from "../utils/theme";

	const root = document.documentElement;
	const toast = document.querySelector<HTMLElement>(".theme-toast");
	let hideTimer: number | undefined;

	// Account menu: close on outside click or Escape.
	const who = document.querySelector<HTMLDetailsElement>("details.who");
	if (who) {
		document.addEventListener("click", (e) => {
			if (who.open && e.target instanceof Node && !who.contains(e.target)) who.open = false;
		});
		who.addEventListener("keydown", (e) => {
			if (e.key !== "Escape" || !who.open) return;
			who.open = false;
			who.querySelector("summary")?.focus();
		});
	}

	document.addEventListener("keydown", (e) => {
		if (e.key.toLowerCase() !== "t" || e.ctrlKey || e.metaKey || e.altKey || e.repeat) return;
		const target = e.target;
		if (target instanceof HTMLElement && target.closest("input, textarea, select, [contenteditable]")) return;
		const i = THEMES.findIndex((t) => t.id === root.dataset.theme);
		const next = THEMES[(i + (e.shiftKey ? -1 : 1) + THEMES.length) % THEMES.length];
		root.dataset.theme = next.id;
		document.querySelector('meta[name="theme-color"]')?.setAttribute("content", next.color);
		if (!toast) return;
		toast.textContent = `${next.emoji} ${next.label}`;
		toast.hidden = false;
		clearTimeout(hideTimer);
		hideTimer = window.setTimeout(() => (toast.hidden = true), 1500);
	});
</script>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		position: relative;
		isolation: isolate;
		padding-block: 0.6rem;
		padding-inline: calc(var(--gutter) + 0.6rem);
		margin-block-start: 1rem;
	}
	.nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		font-weight: 700;
		font-size: 0.9375rem;
	}
	.nav a[aria-current="page"] {
		color: var(--accent-ink);
		text-decoration-thickness: 3px;
	}
	.who {
		position: relative;
		font-size: 0.9375rem;
	}
	.who summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.75rem 0.25rem 0.25rem;
		border-radius: 999px;
		font-weight: 700;
		list-style: none;
		cursor: pointer;
	}
	.who summary::-webkit-details-marker {
		display: none;
	}
	.who summary:hover .who-caret,
	.who[open] .who-caret {
		color: var(--ink);
	}
	.who[open] .who-caret {
		rotate: 180deg;
	}
	.who-avatar {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		flex: none;
		border-radius: 50%;
		object-fit: cover;
		background: var(--accent-ink);
		color: var(--on-accent);
		font-size: 0.75rem;
		line-height: 1;
	}
	.who-caret {
		width: 0.75rem;
		height: 0.75rem;
		color: var(--slate);
		transition: rotate 0.15s;
	}
	.who-menu {
		position: absolute;
		inset-block-start: calc(100% + 0.5rem);
		inset-inline-end: 0;
		z-index: 5;
		display: grid;
		min-width: 13rem;
		padding: 0.4rem;
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		background: var(--sheet);
		box-shadow: 0 0.6rem 1.2rem -0.6rem rgb(0 0 0 / 0.35);
	}
	.who-head {
		margin: 0 0 0.3rem;
		padding: 0.4rem 0.6rem 0.6rem;
		border-block-end: 1px solid var(--rule);
		color: var(--slate);
		font-size: 0.8125rem;
		line-height: 1.3;
	}
	.who-head strong {
		display: block;
		color: var(--ink);
		font-size: 0.9375rem;
	}
	.who-menu a,
	.who-menu button {
		display: block;
		width: 100%;
		padding: 0.45rem 0.6rem;
		border: 0;
		border-radius: calc(var(--radius) - 0.15rem);
		background: none;
		color: var(--ink);
		font: inherit;
		line-height: 1.3;
		text-align: start;
		text-decoration: none;
		cursor: pointer;
	}
	.who-menu a:hover,
	.who-menu button:hover {
		background: var(--paper);
	}
	.who-menu form {
		margin-block-start: 0.3rem;
		padding-block-start: 0.3rem;
		border-block-start: 1px solid var(--rule);
	}
	.who-menu button {
		color: var(--accent-ink);
	}
	.sign-in {
		padding: 0.35rem 0.9rem;
		border: 2px solid var(--ink);
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.9375rem;
		text-decoration: none;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 700;
		font-size: 1rem;
		text-decoration: none;
	}
	.brand-mark {
		width: 1.375rem;
		height: 1.375rem;
		flex: none;
	}
	.brand-logo {
		display: block;
		height: 2.5rem;
		width: auto;
	}
	/* The daily banner is the header's backdrop on every page. */
	.header-art {
		position: absolute;
		inset: 0 var(--gutter);
		z-index: -1;
		border-radius: 999px;
		overflow: hidden;
	}
	@media (max-width: 40rem) {
		.header-art {
			border-radius: 1.6rem;
		}
	}
	/* Paper pills keep the links readable over a generated image. */
	.site-header .brand,
	.site-header .nav,
	.site-header .who,
	.site-header .sign-in {
		background: color-mix(in srgb, var(--sheet) 88%, transparent);
		border-radius: 999px;
	}
	.site-header .brand,
	.site-header .nav {
		padding: 0.4rem 0.9rem;
	}
	main {
		padding-block-end: 3rem;
	}
	.wide {
		--measure: 72rem;
	}
	.theme-toast {
		position: fixed;
		inset-block-end: 1.5rem;
		inset-inline-start: 50%;
		translate: -50% 0;
		z-index: 10;
		margin: 0;
		padding: 0.5rem 1rem;
		border-radius: 999px;
		background: var(--accent-ink);
		color: var(--on-accent);
		font-weight: 700;
		line-height: 1.3;
	}
</style>
