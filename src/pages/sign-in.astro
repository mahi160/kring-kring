---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import { currentStaffId, isCrossSite, safeNext, setStaffCookie, staffAuth } from "../staff/index.ts";
import { formatTime } from "../utils/dates";
import { displayName, isActive } from "../utils/people";
import "../styles/forms.css";

const next = safeNext(Astro.url.searchParams.get("next"));
if (currentStaffId(Astro.cookies)) return Astro.redirect(next, 303);

const { entries, error: loadError } = await getEmDashCollection("people", { limit: 1000 });
if (loadError) console.error("Failed to load people:", loadError);
// Inactive people can't sign in: they aren't listed and a posted id is refused like any unknown one.
const people = entries
	.filter(isActive)
	.map((p) => ({ id: p.data.id, name: displayName(p.data) }))
	.sort((a, b) => a.name.localeCompare(b.name));

let error: string | null = null;
let chosen = "";
// First sign-in for someone with no PIN: they choose one and type it twice.
// "First time?" links here with ?setup=1 so new staff skip the sign-in attempt.
// A POST decides from its fields instead, since the form posts back to the same URL.
let settingUp = Astro.request.method !== "POST" && Astro.url.searchParams.has("setup");
const nextQuery = `next=${encodeURIComponent(next)}`;
if (Astro.request.method === "POST" && isCrossSite(Astro.request)) {
	return new Response("Cross-site request blocked", { status: 403 });
}
if (Astro.request.method === "POST") {
	const form = await Astro.request.formData();
	chosen = String(form.get("person") ?? "");
	const pin = String(form.get("pin") ?? "").trim();
	if (!people.some((p) => p.id === chosen)) {
		error = "Pick your name from the list.";
		Astro.response.status = 400;
	} else if (form.has("confirm")) {
		settingUp = true;
		if (pin !== String(form.get("confirm") ?? "").trim()) {
			error = "The two PINs don't match.";
			Astro.response.status = 400;
		} else {
			const result = await staffAuth().claimPin(chosen, pin);
			if (result.ok) {
				setStaffCookie(Astro.cookies, result.token);
				return Astro.redirect(next, 303);
			}
			if (result.reason === "taken") {
				settingUp = false;
				error = "This name already has a PIN. Sign in with it, or ask the office admin to reset it.";
				Astro.response.status = 409;
			} else {
				error = "The PIN must be exactly 4 digits.";
				Astro.response.status = 400;
			}
		}
	} else {
		const result = await staffAuth().signIn(chosen, pin);
		if (result.ok) {
			setStaffCookie(Astro.cookies, result.token);
			return Astro.redirect(next, 303);
		}
		if (result.reason === "no-pin") {
			settingUp = true;
			error = "You haven't set a PIN yet. Choose one below.";
			Astro.response.status = 400;
		} else {
			error =
				result.reason === "locked"
					? `Too many wrong PINs. Try again after ${formatTime(new Date(result.lockedUntil))}.`
					: `That PIN didn't match. ${result.triesLeft} ${result.triesLeft === 1 ? "try" : "tries"} left before a 15-minute lock.`;
			Astro.response.status = result.reason === "locked" ? 429 : 401;
		}
	}
}
---

<Base title={settingUp ? "Set up your PIN" : "Sign in"}>
	<div class="form-page">
		<section class="card" aria-labelledby="title">
			<h1 id="title" class="card-title">{settingUp ? "First time here" : "Sign in"}</h1>
			<p class="intro">
				{settingUp
					? "Pick your name and choose a 4-digit PIN. Remember it: you'll use it every time you sign in."
					: "For the daily quiz and reactions. Reading the hub never needs a PIN."}
			</p>
			{error && <p class="error" role="alert" id="error">{error}</p>}
			<form method="post">
				<label for="person">Your name</label>
				<select id="person" name="person" required>
					<option value="" disabled selected={!chosen}>Choose your name</option>
					{people.map((p) => <option value={p.id} selected={p.id === chosen}>{p.name}</option>)}
				</select>
				<label for="pin">{settingUp ? "Choose a 4-digit PIN" : "4-digit PIN"}</label>
				<input
					id="pin"
					name="pin"
					type="password"
					inputmode="numeric"
					pattern="[0-9]{4}"
					maxlength="4"
					autocomplete="off"
					required
					aria-describedby={error ? "error" : undefined}
				/>
				{settingUp && (
					<>
						<label for="confirm">Same PIN again</label>
						<input
							id="confirm"
							name="confirm"
							type="password"
							inputmode="numeric"
							pattern="[0-9]{4}"
							maxlength="4"
							autocomplete="off"
							required
						/>
					</>
				)}
				<button type="submit">{settingUp ? "Set PIN and sign in" : "Sign in"}</button>
			</form>
			<a class="switch" href={settingUp ? `/sign-in?${nextQuery}` : `/sign-in?setup=1&${nextQuery}`}>
				{settingUp ? "Already have a PIN? Sign in" : "First time? Set up your PIN"}
			</a>
			<p class="hint">Forgot your PIN? Ask the office admin on Slack.</p>
		</section>
	</div>
</Base>

<style>
	.switch {
		display: block;
		margin-block-start: 0.75rem;
		padding: 0.6rem 1rem;
		border: 2px solid var(--accent-ink);
		border-radius: 999px;
		color: var(--accent-ink);
		font-weight: 700;
		text-align: center;
		text-decoration: none;
	}
	.switch:hover {
		background: color-mix(in srgb, var(--accent-ink) 10%, transparent);
	}
	.switch:focus-visible {
		outline: 3px solid var(--highlight);
		outline-offset: 2px;
	}
</style>
