---
import { getEmDashEntry } from "emdash";
import { withEmDashRuntime } from "emdash/middleware";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { currentStaffId, isCrossSite, signOutStaff } from "../../staff/index.ts";
import { MONTHS } from "../../utils/celebrations";
import { displayName, isActive } from "../../utils/people";
import {
	BLOOD_GROUPS,
	MAX_BIO,
	MAX_DESIGNATION,
	MAX_EMAIL,
	MAX_EMERGENCY_NAME,
	MAX_PHONE,
	MAX_PREFERRED_NAME,
	MAX_RELATION,
	MAX_SLACK,
	MAX_PHOTO_BYTES,
	MAX_TEAM,
	parseProfile,
	type ProfileField,
	type ProfileValues,
} from "../../utils/profile";
import "../../styles/forms.css";

const post = Astro.request.method === "POST";
if (post && isCrossSite(Astro.request)) {
	return new Response("Cross-site request blocked", { status: 403 });
}
// The person always comes from the session cookie, never from the form.
const personId = currentStaffId(Astro.cookies);
if (!personId) return Astro.redirect("/sign-in?next=/people/me", 303);
const { entry: person } = await getEmDashEntry("people", personId);
if (!person || !isActive(person)) {
	// A removed or deactivated person's session is dead; clear it so sign-in doesn't bounce back here.
	signOutStaff(Astro.cookies);
	return Astro.redirect("/sign-in?next=/people/me", 303);
}

let values: ProfileValues = {
	preferred_name: person.data.preferred_name ?? "",
	team: person.data.team ?? "",
	designation: person.data.designation ?? "",
	birthday_month: person.data.birthday_month ?? "",
	birthday_day: person.data.birthday_day ? String(person.data.birthday_day) : "",
	hide_birthday: person.data.hide_birthday ?? false,
	phone: person.data.phone ?? "",
	email: person.data.email ?? "",
	slack: person.data.slack ?? "",
	github: person.data.github ?? "",
	blood_group: person.data.blood_group ?? "",
	emergency_name: person.data.emergency_name ?? "",
	emergency_relation: person.data.emergency_relation ?? "",
	emergency_phone: person.data.emergency_phone ?? "",
	bio: person.data.bio ?? "",
	remove_photo: false,
};
let errors: Partial<Record<ProfileField, string>> = {};
let failure: string | null = null;

if (post) {
	const result = await parseProfile(await Astro.request.formData());
	if (!result.ok) {
		({ errors, values } = result);
		Astro.response.status = 400;
	} else {
		// Trusted runtime: staff aren't EmDash users, so there's no actor and revisions record no author.
		// People keep drafts, so an update only stages a revision: publish it to make the edit live.
		const saved = await withEmDashRuntime(async (runtime) => {
			const data: Record<string, unknown> = { ...result.data };
			if (result.photo) {
				const upload = await runtime.handleMediaUpload({
					...result.photo,
					alt: displayName(person.data),
					maxUploadSize: MAX_PHOTO_BYTES,
				});
				if (!upload.success) return { error: "photo" as const, message: upload.error.message };
				data.photo = { provider: "local", id: upload.data.item.id, alt: displayName(person.data) };
			} else if (result.removePhoto) {
				data.photo = null;
			}
			const update = await runtime.handleContentUpdate("people", personId, { data });
			if (!update.success) return { error: "save" as const, message: update.error.message };
			const publish = await runtime.handleContentPublish("people", personId);
			if (!publish.success) return { error: "save" as const, message: publish.error.message };
			return null;
		});
		if (!saved) return Astro.redirect(`/people?saved=1#p-${person.id}`, 303);
		console.error(`Profile save failed for ${personId}: ${saved.message}`);
		values = result.values;
		if (saved.error === "photo") errors.photo = "The photo couldn't be uploaded. Try a smaller JPEG, PNG or WebP.";
		else failure = "Your profile couldn't be saved. Please try again.";
		Astro.response.status = 500;
	}
}

const fields: [ProfileField, string][] = [
	["preferred_name", "Preferred name"],
	["photo", "Photo"],
	["team", "Team"],
	["designation", "Designation"],
	["birthday_month", "Birthday month"],
	["birthday_day", "Birthday day"],
	["phone", "Phone"],
	["email", "Email"],
	["slack", "Slack name"],
	["github", "GitHub username"],
	["blood_group", "Blood group"],
	["emergency_name", "Emergency contact name"],
	["emergency_relation", "Emergency contact relation"],
	["emergency_phone", "Emergency contact phone"],
	["bio", "Short bio"],
];
const problems = fields.filter(([key]) => errors[key]);
const describe = (key: ProfileField, hint?: string) =>
	[errors[key] ? `${key}-error` : "", hint].filter(Boolean).join(" ") || undefined;
const joinedOn = person.data.joined_on
	? new Intl.DateTimeFormat("en-GB", { dateStyle: "long", timeZone: "Asia/Dhaka" }).format(new Date(person.data.joined_on))
	: null;
---

<Base title="Edit my profile">
	<div class="form-page profile">
		<section class="card" aria-labelledby="title">
			<h1 id="title" class="card-title">Edit my profile</h1>
			<p class="intro">
				Changes show on the People page straight away. Phone, email, Slack, GitHub, blood group and emergency
				contact are shown only to signed-in staff.
			</p>
			{
				problems.length > 0 && (
					<div class="error" role="alert" tabindex="-1" autofocus>
						<p>Please fix {problems.length === 1 ? "this" : "these"} before saving:</p>
						<ul>
							{problems.map(([key, label]) => (
								<li>
									<a href={`#${key}`}>{label}</a>: {errors[key]}
								</li>
							))}
						</ul>
					</div>
				)
			}
			{failure && <p class="error" role="alert" tabindex="-1" autofocus>{failure}</p>}
			<dl class="readonly">
				<dt>Name</dt>
				<dd>{person.data.name}</dd>
				{joinedOn && <><dt>Joined</dt><dd>{joinedOn}</dd></>}
			</dl>
			<p class="hint" style="margin-block: 0.5rem 1.5rem">Your name and joining date are set by the office admin.</p>
			<form method="post" enctype="multipart/form-data" novalidate>
				<label for="preferred_name">Preferred name</label>
				<input
					id="preferred_name"
					name="preferred_name"
					type="text"
					maxlength={MAX_PREFERRED_NAME}
					value={values.preferred_name}
					autocomplete="nickname"
					aria-invalid={errors.preferred_name ? "true" : undefined}
					aria-describedby={describe("preferred_name", "preferred_name-hint")}
				/>
				<p class="field-hint" id="preferred_name-hint">What the hub calls you, e.g. Shariful. Leave empty to use your full name.</p>
				{errors.preferred_name && <p class="field-error" id="preferred_name-error">{errors.preferred_name}</p>}

				<label for="photo">Photo</label>
				{person.data.photo && <Image image={person.data.photo} alt="Your current photo" width={96} height={96} class="current-photo" />}
				<input
					id="photo"
					name="photo"
					type="file"
					accept="image/jpeg,image/png,image/webp"
					aria-invalid={errors.photo ? "true" : undefined}
					aria-describedby={describe("photo", "photo-hint")}
				/>
				<p class="field-hint" id="photo-hint">JPEG, PNG or WebP, up to 3 MB. Leave empty to keep your current photo.</p>
				{errors.photo && <p class="field-error" id="photo-error">{errors.photo}</p>}
				{
					person.data.photo && (
						<label class="check">
							<input type="checkbox" name="remove_photo" checked={values.remove_photo} /> Remove my photo
						</label>
					)
				}

				<label for="team">Team</label>
				<input
					id="team"
					name="team"
					type="text"
					maxlength={MAX_TEAM}
					value={values.team}
					autocomplete="organization-title"
					aria-invalid={errors.team ? "true" : undefined}
					aria-describedby={describe("team")}
				/>
				{errors.team && <p class="field-error" id="team-error">{errors.team}</p>}

				<label for="designation">Designation</label>
				<input
					id="designation"
					name="designation"
					type="text"
					maxlength={MAX_DESIGNATION}
					value={values.designation}
					autocomplete="organization-title"
					aria-invalid={errors.designation ? "true" : undefined}
					aria-describedby={describe("designation", "designation-hint")}
				/>
				<p class="field-hint" id="designation-hint">Your job title, e.g. Software Engineer.</p>
				{errors.designation && <p class="field-error" id="designation-error">{errors.designation}</p>}

				<label for="birthday_month">Birthday month</label>
				<select
					id="birthday_month"
					name="birthday_month"
					aria-invalid={errors.birthday_month ? "true" : undefined}
					aria-describedby={describe("birthday_month")}
				>
					<option value="" selected={!values.birthday_month}>Not set</option>
					{MONTHS.map((m) => <option value={m} selected={m === values.birthday_month}>{m}</option>)}
				</select>
				{errors.birthday_month && <p class="field-error" id="birthday_month-error">{errors.birthday_month}</p>}

				<label for="birthday_day">Birthday day</label>
				<input
					id="birthday_day"
					name="birthday_day"
					type="number"
					min="1"
					max="31"
					value={values.birthday_day}
					aria-invalid={errors.birthday_day ? "true" : undefined}
					aria-describedby={describe("birthday_day")}
				/>
				{errors.birthday_day && <p class="field-error" id="birthday_day-error">{errors.birthday_day}</p>}
				<label class="check">
					<input type="checkbox" name="hide_birthday" checked={values.hide_birthday} /> Hide my birthday on the hub
				</label>

				<label for="phone">Phone</label>
				<input
					id="phone"
					name="phone"
					type="tel"
					maxlength={MAX_PHONE}
					value={values.phone}
					autocomplete="tel"
					aria-invalid={errors.phone ? "true" : undefined}
					aria-describedby={describe("phone", "phone-hint")}
				/>
				<p class="field-hint" id="phone-hint">Digits, spaces, + and - only.</p>
				{errors.phone && <p class="field-error" id="phone-error">{errors.phone}</p>}

				<label for="email">Email</label>
				<input
					id="email"
					name="email"
					type="email"
					maxlength={MAX_EMAIL}
					value={values.email}
					autocomplete="email"
					aria-invalid={errors.email ? "true" : undefined}
					aria-describedby={describe("email")}
				/>
				{errors.email && <p class="field-error" id="email-error">{errors.email}</p>}

				<label for="slack">Slack name</label>
				<input
					id="slack"
					name="slack"
					type="text"
					maxlength={MAX_SLACK + 1}
					value={values.slack}
					autocapitalize="off"
					spellcheck="false"
					aria-invalid={errors.slack ? "true" : undefined}
					aria-describedby={describe("slack", "slack-hint")}
				/>
				<p class="field-hint" id="slack-hint">Your Slack display name, e.g. mahi.</p>
				{errors.slack && <p class="field-error" id="slack-error">{errors.slack}</p>}

				<label for="github">GitHub username</label>
				<input
					id="github"
					name="github"
					type="text"
					value={values.github}
					autocapitalize="off"
					spellcheck="false"
					aria-invalid={errors.github ? "true" : undefined}
					aria-describedby={describe("github")}
				/>
				{errors.github && <p class="field-error" id="github-error">{errors.github}</p>}

				<label for="blood_group">Blood group</label>
				<select
					id="blood_group"
					name="blood_group"
					aria-invalid={errors.blood_group ? "true" : undefined}
					aria-describedby={describe("blood_group")}
				>
					<option value="" selected={!values.blood_group}>Not set</option>
					{BLOOD_GROUPS.map((g) => <option value={g} selected={g === values.blood_group}>{g}</option>)}
				</select>
				{errors.blood_group && <p class="field-error" id="blood_group-error">{errors.blood_group}</p>}

				<h2 class="form-section">Emergency contact</h2>
				<p class="field-hint" style="margin-block-start: 0">Who we call if something happens to you at work.</p>

				<label for="emergency_name">Name</label>
				<input
					id="emergency_name"
					name="emergency_name"
					type="text"
					maxlength={MAX_EMERGENCY_NAME}
					value={values.emergency_name}
					aria-invalid={errors.emergency_name ? "true" : undefined}
					aria-describedby={describe("emergency_name")}
				/>
				{errors.emergency_name && <p class="field-error" id="emergency_name-error">{errors.emergency_name}</p>}

				<label for="emergency_relation">Relation</label>
				<input
					id="emergency_relation"
					name="emergency_relation"
					type="text"
					maxlength={MAX_RELATION}
					value={values.emergency_relation}
					aria-invalid={errors.emergency_relation ? "true" : undefined}
					aria-describedby={describe("emergency_relation", "emergency_relation-hint")}
				/>
				<p class="field-hint" id="emergency_relation-hint">e.g. Mother, Spouse, Brother.</p>
				{errors.emergency_relation && <p class="field-error" id="emergency_relation-error">{errors.emergency_relation}</p>}

				<label for="emergency_phone">Phone</label>
				<input
					id="emergency_phone"
					name="emergency_phone"
					type="tel"
					maxlength={MAX_PHONE}
					value={values.emergency_phone}
					aria-invalid={errors.emergency_phone ? "true" : undefined}
					aria-describedby={describe("emergency_phone")}
				/>
				{errors.emergency_phone && <p class="field-error" id="emergency_phone-error">{errors.emergency_phone}</p>}

				<h2 class="form-section">About you</h2>

				<label for="bio">Short bio</label>
				<textarea
					id="bio"
					name="bio"
					rows="4"
					maxlength={MAX_BIO}
					aria-invalid={errors.bio ? "true" : undefined}
					aria-describedby={describe("bio", "bio-hint")}>{values.bio}</textarea>
				<p class="field-hint" id="bio-hint">Up to {MAX_BIO} characters.</p>
				{errors.bio && <p class="field-error" id="bio-error">{errors.bio}</p>}

				<button type="submit">Save profile</button>
			</form>
			<p class="hint"><a href="/people">Back to People</a></p>
		</section>
	</div>
</Base>
