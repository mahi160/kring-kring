---
import { decodeSlug, getEmDashEntry } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { currentStaffId } from "../../staff/index.ts";
import { initials, isActive } from "../../utils/people";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");
const { entry: person } = await getEmDashEntry("people", slug);
if (!person || !isActive(person)) return Astro.rewrite("/404");

// Contact and emergency details are for signed-in, still-active staff only, and the page must never be cached.
Astro.response.headers.set("Cache-Control", "private, no-store");
const viewerId = currentStaffId(Astro.cookies);
const viewer = viewerId ? (await getEmDashEntry("people", viewerId)).entry : null;
const signedIn = !!viewer && isActive(viewer);
const mine = signedIn && viewer.data.id === person.data.id;

const d = person.data;
const birthday = !d.hide_birthday && d.birthday_month && d.birthday_day ? `${d.birthday_day} ${d.birthday_month}` : null;
const joinedAt = d.joined_on ? new Date(d.joined_on) : null;
const joined =
	joinedAt && !Number.isNaN(joinedAt.getTime())
		? new Intl.DateTimeFormat("en-GB", { month: "long", year: "numeric", timeZone: "Asia/Dhaka" }).format(joinedAt)
		: null;
const tel = (phone: string) => `tel:${phone.replaceAll(" ", "")}`;
const contact = signedIn
	? [
			d.phone && { label: "Phone", text: d.phone, href: tel(d.phone) },
			d.email && { label: "Email", text: d.email, href: `mailto:${d.email}` },
			d.slack && { label: "Slack", text: `@${d.slack}` },
			d.github && { label: "GitHub", text: d.github, href: `https://github.com/${encodeURIComponent(d.github)}` },
		].filter((x): x is { label: string; text: string; href?: string } => !!x)
	: [];
const hasEmergency = signedIn && (d.blood_group || d.emergency_phone);
const signIn = `/sign-in?next=${encodeURIComponent(`/people/${slug}`)}`;
---

<Base title={d.name} wide>
	<p class="back"><a href="/people">← All people</a></p>
	<div class="profile">
		<section class="card about" aria-labelledby="name">
			{
				d.photo ? (
					<Image image={d.photo} alt="" width={144} height={144} class="avatar" />
				) : (
					<span class="avatar" aria-hidden="true">
						{initials(d.name)}
					</span>
				)
			}
			<h1 id="name" class="name">{d.name}</h1>
			{d.designation && <p class="designation">{d.designation}</p>}
			{d.team && <p class="team">{d.team}</p>}
			{d.bio && <p class="bio">{d.bio}</p>}
			{
				(birthday || joined) && (
					<dl class="facts">
						{birthday && (
							<div>
								<dt>Birthday</dt>
								<dd>{birthday}</dd>
							</div>
						)}
						{joined && (
							<div>
								<dt>Joined</dt>
								<dd>{joined}</dd>
							</div>
						)}
					</dl>
				)
			}
			{mine && <a class="edit" href="/people/me">Edit my profile</a>}
		</section>

		<div class="side">
			{
				!signedIn ? (
					<section class="card locked" aria-labelledby="locked-title">
						<h2 id="locked-title" class="card-title">Contact details</h2>
						<p>Phone, email, Slack, GitHub and emergency details are for staff only.</p>
						<a class="button" href={signIn}>Sign in to see them</a>
					</section>
				) : (
					<>
						<section class="card" aria-labelledby="contact-title">
							<h2 id="contact-title" class="card-title">Contact</h2>
							{contact.length === 0 ? (
								<p class="empty">{mine ? <>Nothing added yet. <a href="/people/me">Add your contact details</a>.</> : "No contact details added yet."}</p>
							) : (
								<dl class="list">
									{contact.map((c) => (
										<div>
											<dt>{c.label}</dt>
											<dd>{c.href ? <a href={c.href}>{c.text}</a> : c.text}</dd>
										</div>
									))}
								</dl>
							)}
						</section>
						<section class="card emergency" aria-labelledby="emergency-title">
							<h2 id="emergency-title" class="card-title">In an emergency</h2>
							{!hasEmergency ? (
								<p class="empty">{mine ? <>Not added yet. <a href="/people/me">Add your emergency contact</a>.</> : "No emergency details added yet."}</p>
							) : (
								<dl class="list">
									{d.blood_group && (
										<div>
											<dt>Blood group</dt>
											<dd class="blood">{d.blood_group}</dd>
										</div>
									)}
									{d.emergency_phone && (
										<div>
											<dt>Call</dt>
											<dd>
												{d.emergency_name && <span class="who">{d.emergency_name}</span>}
												{d.emergency_relation && <span class="relation"> ({d.emergency_relation})</span>}
												<a class="call" href={tel(d.emergency_phone)}>{d.emergency_phone}</a>
											</dd>
										</div>
									)}
								</dl>
							)}
						</section>
					</>
				)
			}
		</div>
	</div>
</Base>

<style>
	.back {
		margin: clamp(1.5rem, 1rem + 2vw, 2.5rem) 0 1.5rem;
		font-weight: 700;
	}
	.back a {
		color: var(--ink);
	}
	.profile {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
		align-items: start;
		margin-block-end: 3rem;
	}
	@media (min-width: 52rem) {
		.profile {
			grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		}
	}
	.about {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.4rem;
		padding: 2rem 1.75rem 1.75rem;
	}
	.avatar {
		display: grid;
		place-items: center;
		width: 7rem;
		aspect-ratio: 1;
		margin-block-end: 0.5rem;
		border-radius: 50%;
		object-fit: cover;
		background: var(--note-sky);
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 2.75rem;
		font-weight: 800;
	}
	.name {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 1.75rem + 2vw, 3.25rem);
		font-weight: 800;
		line-height: 1;
		overflow-wrap: anywhere;
	}
	.designation {
		margin: 0.25rem 0 0;
		font-size: 1.125rem;
		font-weight: 700;
	}
	.team {
		margin: 0;
		color: var(--slate);
		font-weight: 700;
	}
	.bio {
		margin: 0.75rem 0 0;
		max-width: 38rem;
		font-size: 1.0625rem;
		line-height: 1.55;
	}
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		margin: 1rem 0 0;
		padding-block-start: 1rem;
		border-block-start: 1px dashed var(--rule);
		align-self: stretch;
	}
	.facts dd,
	.list dd {
		margin: 0;
		overflow-wrap: anywhere;
	}
	.facts dt,
	.list dt {
		color: var(--slate);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.edit,
	.button {
		display: inline-block;
		margin-block-start: 1rem;
		padding: 0.5rem 1rem;
		border-radius: 999px;
		background: var(--accent-ink);
		color: var(--on-accent);
		font-weight: 700;
		text-decoration: none;
	}
	.edit:hover,
	.button:hover {
		text-decoration: underline;
	}
	.edit:focus-visible,
	.button:focus-visible,
	.list a:focus-visible,
	.empty a:focus-visible,
	.back a:focus-visible {
		outline: 3px solid var(--highlight);
		outline-offset: 2px;
	}
	.side {
		display: grid;
		gap: 2rem;
	}
	.list {
		display: grid;
		gap: 0.85rem;
		margin: 0;
	}
	.list a {
		color: inherit;
		font-weight: 700;
	}
	.empty {
		margin: 0;
		color: var(--slate);
	}
	.empty a {
		color: var(--ink);
		font-weight: 700;
	}
	.locked {
		background: var(--note-sky);
		color: var(--ink);
		rotate: -0.6deg;
	}
	.locked p {
		margin: 0;
	}
	.emergency {
		background: var(--note-pink);
		color: var(--ink);
		rotate: 0.5deg;
	}
	.emergency dt,
	.emergency .empty,
	.locked .empty {
		color: color-mix(in srgb, var(--ink) 75%, transparent);
	}
	.blood {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 800;
		line-height: 1;
	}
	.who {
		font-weight: 700;
	}
	.call {
		display: block;
		margin-block-start: 0.15rem;
		font-size: 1.25rem;
		font-variant-numeric: tabular-nums;
	}
</style>
