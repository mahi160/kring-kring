---
import type { WeatherIconName } from "../utils/weather";

interface Props {
	name: WeatherIconName;
}

const { name } = Astro.props;

const CLOUD = "M18 47a8.5 8.5 0 0 1 .8-16.9A12 12 0 0 1 41.5 27a9 9 0 0 1 5.5 20Z";
const DROP = "M0 0c-2.6 3.4-3.6 5.3-3.6 6.9a3.6 3.6 0 0 0 7.2 0C3.6 5.3 2.6 3.4 0 0Z";

// Eight sun rays, as [x1, y1, x2, y2] around a 64x64 centre.
const rays = Array.from({ length: 8 }, (_, i) => {
	const a = (i * Math.PI) / 4;
	const at = (r: number) => (32 + r * Math.cos(a)).toFixed(1);
	const atY = (r: number) => (32 + r * Math.sin(a)).toFixed(1);
	return [at(17), atY(17), at(24), atY(24)];
});

const sunny = name === "clear-day";
const moony = name === "clear-night";
const partly = name === "partly-day" || name === "partly-night";
const night = name === "partly-night";
const raining = name === "drizzle" || name === "rain" || name === "heavy-rain";
const dropXs = name === "heavy-rain" ? [24, 32, 40, 48] : name === "drizzle" ? [27, 37, 47] : [26, 36, 46];
const clouds = ["partly-day", "partly-night", "overcast", "fog", "drizzle", "rain", "heavy-rain", "thunder", "snow"].includes(name);
---

<svg class="weather-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
	{
		sunny && (
			<>
				<g class="rays">
					{rays.map(([x1, y1, x2, y2]) => (
						<line {x1} {y1} {x2} {y2} />
					))}
				</g>
				<circle class="sun" cx="32" cy="32" r="11" />
				<circle class="dot" cx="28" cy="30" r="1.6" />
				<circle class="dot" cx="36" cy="30" r="1.6" />
				<path d="M27.5 35q4.5 4.5 9 0" />
			</>
		)
	}
	{
		moony && (
			<g class="bob">
				<path class="moon" d="M38 8A24 24 0 1 0 56 40 19 19 0 0 1 38 8Z" />
				<circle class="dot" cx="27" cy="37" r="1.6" />
				<path d="M24.5 43q4 3.5 8 0" />
				<path class="star" d="M52 14v6M49 17h6" />
			</g>
		)
	}
	{
		partly && !night && (
			<g transform="translate(-8 -8) scale(.8)">
				<g class="rays">
					{rays.map(([x1, y1, x2, y2]) => (
						<line {x1} {y1} {x2} {y2} />
					))}
				</g>
				<circle class="sun" cx="32" cy="32" r="11" />
			</g>
		)
	}
	{
		night && (
			<g transform="translate(-6 -6) scale(.7)">
				<path class="moon" d="M38 8A24 24 0 1 0 56 40 19 19 0 0 1 38 8Z" />
			</g>
		)
	}
	{
		name === "overcast" && (
			<path class="cloud back" d={CLOUD} transform="translate(12 -8) scale(.8)" />
		)
	}
	{
		clouds && (
			<g class="bob" transform={raining || name === "thunder" || name === "snow" || name === "fog" ? "translate(0 -8)" : undefined}>
				<path class="cloud" d={CLOUD} />
				<circle class="dot" cx="28" cy="39" r="1.6" />
				<circle class="dot" cx="37" cy="39" r="1.6" />
				<path d="M29.5 42.5q3 2.5 6 0" />
			</g>
		)
	}
	{
		raining &&
			dropXs.map((x, i) => (
				<path class="drop" style={`--n:${i}`} d={DROP} transform={`translate(${x} ${name === "drizzle" ? 46 : 45}) scale(${name === "drizzle" ? 0.7 : 1})`} />
			))
	}
	{
		name === "thunder" && (
			<path class="bolt" d="M35 42l-7 10h6l-3 9 11-13h-6.5l4-6Z" />
		)
	}
	{
		name === "snow" &&
			[26, 36, 46].map((x, i) => (
				<g class="flake" style={`--n:${i}`}>
					<path d={`M${x} 47v8M${x - 3.5} 49l7 4M${x + 3.5} 49l-7 4`} />
				</g>
			))
	}
	{
		name === "fog" && (
			<g class="fog">
				<path d="M14 46h34M20 53h34M14 60h26" />
			</g>
		)
	}
</svg>

<style>
	.weather-icon {
		display: block;
		inline-size: 3.5rem;
		block-size: 3.5rem;
		flex: none;
		overflow: visible;
		fill: none;
		stroke: var(--ink);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	/* Sky colours stay true in every theme; a blue sun reads as a bug. */
	.sun,
	.bolt {
		fill: #ffc83d;
	}
	.moon {
		fill: #fff1b8;
	}
	.cloud {
		fill: var(--sheet);
	}
	.cloud.back {
		fill: var(--rule);
	}
	.drop {
		fill: #8ec5ff;
		stroke-width: 2.5;
	}
	.dot {
		fill: var(--ink);
		stroke: none;
	}
	.star,
	.flake path {
		stroke-width: 2.5;
	}
	.fog path {
		stroke: var(--slate);
	}

	@media (prefers-reduced-motion: no-preference) {
		.rays {
			transform-origin: 32px 32px;
			animation: spin 24s linear infinite;
		}
		.bob {
			animation: bob 4s ease-in-out infinite;
		}
		.drop,
		.flake {
			animation: fall 1.6s ease-in infinite;
			animation-delay: calc(var(--n) * -0.5s);
		}
		.bolt {
			animation: flash 3s steps(1) infinite;
		}
		.fog {
			animation: drift 5s ease-in-out infinite alternate;
		}
	}
	@keyframes spin {
		to {
			rotate: 360deg;
		}
	}
	@keyframes bob {
		50% {
			translate: 0 -1.5px;
		}
	}
	@keyframes fall {
		from {
			translate: 0 -3px;
			opacity: 0;
		}
		30% {
			opacity: 1;
		}
		to {
			translate: 0 6px;
			opacity: 0;
		}
	}
	@keyframes flash {
		0%,
		70%,
		80%,
		100% {
			opacity: 1;
		}
		75% {
			opacity: 0.25;
		}
	}
	@keyframes drift {
		to {
			translate: 3px 0;
		}
	}
</style>
