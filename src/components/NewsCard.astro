---
import type { News } from "../utils/news";

interface Props {
	news: News | null;
}

const { news } = Astro.props;

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-");

function ago(ms: number): string {
	const mins = Math.max(0, Math.floor(ms / 60_000));
	if (mins < 1) return "just now";
	if (mins < 60) return `${mins} min ago`;
	const hours = Math.floor(mins / 60);
	return hours < 24 ? `${hours} h ago` : `${Math.floor(hours / 24)} d ago`;
}
---

{
	news && (
		<section class="card news" id="news" aria-labelledby="news-title" data-news>
			<div class="head">
				<h2 id="news-title" class="card-title">In the news</h2>
				<form method="post" action="/news-refresh">
					<p class="updated">
						Updated <time datetime={new Date(news.fetchedAt).toISOString()}>{ago(Date.now() - news.fetchedAt)}</time>
					</p>
					<button type="submit" class="refresh">
						<span aria-hidden="true">↻</span> Refresh
					</button>
				</form>
			</div>
			<div class="tabs" role="tablist" aria-label="News topics" hidden>
				{news.tabs.map((tab, i) => (
					<button
						type="button"
						role="tab"
						id={`news-tab-${slug(tab.name)}`}
						aria-controls={`news-panel-${slug(tab.name)}`}
						aria-selected={i === 0 ? "true" : "false"}
						tabindex={i === 0 ? 0 : -1}
					>
						{tab.name}
					</button>
				))}
			</div>
			{news.tabs.map((tab) => (
				<div
					class="panel"
					role="tabpanel"
					id={`news-panel-${slug(tab.name)}`}
					aria-labelledby={`news-tab-${slug(tab.name)}`}
				>
					<h3 class="panel-title">{tab.name}</h3>
					<div class="sources">
						{tab.sources.map(({ source, headlines }) => (
							<div class="source">
								<h4>{source.name}</h4>
								<ul lang={source.lang} role="list">
									{headlines.map((h) => (
										<li>
											<a href={h.url} rel="noopener">{h.title}</a>
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
					<p class="credit">
						via{" "}
						{tab.sources.map(({ source }, i) => (
							<>
								{i > 0 && ", "}
								<a href={source.home} rel="noopener">{source.name}</a>
							</>
						))}
					</p>
				</div>
			))}
		</section>
	)
}

<style>
	.news {
		margin-block: 2.75rem 0;
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
	}
	.head form {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.updated {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--slate);
	}
	.refresh {
		font: inherit;
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.5;
		padding: 0.25rem 0.75rem;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: var(--sheet);
		color: var(--ink);
		cursor: pointer;
	}
	.refresh:hover {
		background: var(--accent-soft);
	}
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-block: 0.5rem 1rem;
	}
	.tabs[hidden] {
		display: none;
	}
	[role="tab"] {
		font: inherit;
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.5;
		padding: 0.25rem 0.875rem;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: var(--sheet);
		color: var(--ink);
		cursor: pointer;
	}
	[role="tab"][aria-selected="true"] {
		background: var(--accent);
		color: var(--on-accent);
	}
	.panel + .panel {
		margin-block-start: 1.5rem;
	}
	.panel[hidden] {
		display: none;
	}
	.panel-title {
		margin: 1rem 0 0.5rem;
		font-size: 1.125rem;
		line-height: 1.3;
	}
	/* With the tabs active the buttons already name the panel. */
	[data-news][data-tabs] .panel-title {
		display: none;
	}
	[data-news][data-tabs] .panel + .panel {
		margin-block-start: 0;
	}
	.sources {
		display: grid;
		gap: 1rem 2rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
	}
	h4 {
		margin: 0 0 0.25rem;
		font-size: 0.8125rem;
		line-height: 1.5;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--slate);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		padding-block: 0.5rem;
		border-block-start: 2px dashed var(--rule);
		font-size: 1rem;
		line-height: 1.5;
		overflow-wrap: break-word;
		text-wrap: pretty;
	}
	li:first-child {
		padding-block-start: 0;
		border-block-start: 0;
	}
	.credit {
		margin: 0.5rem 0 0;
		font-size: 0.8125rem;
		color: var(--slate);
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-news]")) {
		const tablist = root.querySelector<HTMLElement>("[role=tablist]");
		const tabs = [...root.querySelectorAll<HTMLElement>("[role=tab]")];
		if (!tablist || tabs.length === 0) continue;
		const select = (tab: HTMLElement, focus = false) => {
			for (const t of tabs) {
				const on = t === tab;
				t.setAttribute("aria-selected", String(on));
				t.tabIndex = on ? 0 : -1;
				const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
				if (panel) panel.hidden = !on;
			}
			if (focus) tab.focus();
		};
		tablist.hidden = false;
		root.dataset.tabs = "";
		select(tabs[0]);
		for (const tab of tabs) tab.addEventListener("click", () => select(tab));
		tablist.addEventListener("keydown", (e) => {
			const i = tabs.findIndex((t) => t === document.activeElement);
			if (i < 0) return;
			const next =
				e.key === "ArrowRight" ? tabs[(i + 1) % tabs.length]
				: e.key === "ArrowLeft" ? tabs[(i - 1 + tabs.length) % tabs.length]
				: e.key === "Home" ? tabs[0]
				: e.key === "End" ? tabs[tabs.length - 1]
				: null;
			if (!next) return;
			e.preventDefault();
			select(next, true);
		});
	}
</script>
