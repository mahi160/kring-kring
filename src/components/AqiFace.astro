---
import type { AqiMood } from "../utils/weather";

interface Props {
	mood: AqiMood;
}

const { mood } = Astro.props;

const SKIN: Record<AqiMood, string> = {
	good: "#9be3a8",
	moderate: "#ffe27a",
	usg: "#ffb86b",
	unhealthy: "#ff8f8f",
	"very-unhealthy": "#b4d65c",
	hazardous: "#c9a0dc",
};

const DROP = "M0 0c-2.6 3.4-3.6 5.3-3.6 6.9a3.6 3.6 0 0 0 7.2 0C3.6 5.3 2.6 3.4 0 0Z";
const SPIRAL = "a1.2 1.2 0 0 1 2.4 0a2.4 2.4 0 0 1-4.8 0a3.6 3.6 0 0 1 7.2 0a4.8 4.8 0 0 1-9.6 0";
const masked = mood === "unhealthy" || mood === "very-unhealthy";
---

<svg class="aqi-face" data-mood={mood} style={`--skin:${SKIN[mood]}`} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
	{mood === "good" && <path class="leaf" d="M47 14q9-1 10 8-9 1-10-8Zm0 0 6 6" />}
	{
		mood === "hazardous" ? (
			<g class="scream">
				<ellipse class="skin" cx="32" cy="33" rx="15" ry="25" />
				<path class="brow" d="M20 17q5-4 10 0M34 17q5-4 10 0" />
				<circle class="white" cx="26" cy="25" r="4.5" />
				<circle class="white" cx="38" cy="25" r="4.5" />
				<circle class="dot" cx="26" cy="26" r="1.8" />
				<circle class="dot" cx="38" cy="26" r="1.8" />
				<ellipse class="mouth" cx="32" cy="45" rx="5" ry="8.5" />
				<ellipse class="hand" cx="13" cy="38" rx="6" ry="8" />
				<ellipse class="hand" cx="51" cy="38" rx="6" ry="8" />
				<path class="fine" d="M11 33l5 3M11 38l6 1M53 33l-5 3M53 38l-6 1" />
			</g>
		) : (
			<g class="bob">
				<circle class="skin" cx="32" cy="32" r="22" />
				{mood === "good" && (
					<>
						<path d="M20 29q3.5-4.5 7 0M37 29q3.5-4.5 7 0M25 37q7 8 14 0" />
						<circle class="cheek" cx="19" cy="36" r="3.2" />
						<circle class="cheek" cx="45" cy="36" r="3.2" />
					</>
				)}
				{mood === "moderate" && (
					<>
						<circle class="dot" cx="24" cy="29" r="2" />
						<circle class="dot" cx="40" cy="29" r="2" />
						<path d="M26 40q6 3 12 0" />
					</>
				)}
				{mood === "usg" && (
					<>
						<path class="fine" d="M19 22l9-3M45 22l-9-3" />
						<circle class="dot" cx="24" cy="29" r="2" />
						<circle class="dot" cx="40" cy="29" r="2" />
						<path d="M25 42q2.4-3 4.8 0t4.8 0 4.8 0" />
						<path class="drop" d={DROP} transform="translate(52 12)" />
					</>
				)}
				{masked && (
					<>
						<path class="fine" d="M16 37l-5-2M48 37l5-2" />
						{mood === "unhealthy" ? (
							<path d="M19 28h8M37 28h8" />
						) : (
							<>
								<path class="spiral" d={`M24 28${SPIRAL}`} />
								<path class="spiral" d={`M40 28${SPIRAL}`} />
							</>
						)}
						<path class="mask" d="M15 35h34v4a13 13 0 0 1-13 13h-8a13 13 0 0 1-13-13Z" />
						<path class="fine" d="M21 41h22M22 46h20" />
					</>
				)}
			</g>
		)
	}
</svg>

<style>
	.aqi-face {
		display: block;
		inline-size: 3.5rem;
		block-size: 3.5rem;
		flex: none;
		overflow: visible;
		fill: none;
		/* The skin tones are fixed light colours, so the line work stays dark in every theme. */
		stroke: #2b2033;
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.skin {
		fill: var(--skin);
	}
	.mask,
	.white {
		fill: #fff;
	}
	.mask {
		stroke-width: 2.5;
	}
	.hand {
		fill: #f3cfae;
		stroke-width: 2.5;
	}
	.mouth {
		fill: #2b2033;
	}
	.leaf {
		fill: #5cc46d;
		stroke-width: 2.5;
	}
	.cheek {
		fill: #ff8fb0;
		stroke: none;
	}
	.drop {
		fill: #8ec5ff;
		stroke-width: 2.5;
	}
	.dot {
		fill: #2b2033;
		stroke: none;
	}
	.fine,
	.spiral,
	.brow {
		stroke-width: 2.5;
	}
	.spiral {
		transform-box: fill-box;
		transform-origin: center;
	}

	@media (prefers-reduced-motion: no-preference) {
		.bob {
			animation: bob 4s ease-in-out infinite;
		}
		.drop {
			animation: fall 2s ease-in infinite;
		}
		.spiral {
			animation: spin 2s linear infinite;
		}
		.scream {
			transform-origin: 32px 58px;
			animation: wobble 1.4s ease-in-out infinite alternate;
		}
	}
	@keyframes bob {
		50% {
			translate: 0 -1.5px;
		}
	}
	@keyframes fall {
		from {
			translate: 0 -2px;
			opacity: 0;
		}
		30% {
			opacity: 1;
		}
		to {
			translate: 0 6px;
			opacity: 0;
		}
	}
	@keyframes spin {
		to {
			rotate: 360deg;
		}
	}
	@keyframes wobble {
		from {
			rotate: -2deg;
		}
		to {
			rotate: 2deg;
		}
	}
</style>
