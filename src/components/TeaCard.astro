---
import { formatHour, type TeaStats } from "../utils/tea";

interface Props {
	stats: TeaStats | null;
}

const { stats } = Astro.props;
const top = stats?.topItems.slice(0, 3) ?? [];
---

{
	stats && (
		<section class="card tea" aria-labelledby="tea-title">
			<h2 id="tea-title" class="card-title">Tea break</h2>
			<p class="cups">
				<span class="count">{stats.cupsToday}</span>
				<span class="label">cups today</span>
			</p>
			{top.length > 0 && (
				<>
					<h3>Top picks this week</h3>
					<ol role="list">
						{top.map((item) => (
							<li>
								<span class="name">{item.name}</span>
								<span class="qty">{item.quantity}</span>
							</li>
						))}
					</ol>
				</>
			)}
			{stats.busiestHour !== null && (
				<p class="busiest">
					Busiest hour: <strong>{formatHour(stats.busiestHour)}</strong>
				</p>
			)}
		</section>
	)
}

<style>
	.tea {
		background: var(--note-mint);
	}
	.cups {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0;
	}
	.count {
		font-family: var(--font-display);
		font-size: 2.5rem;
		font-weight: 800;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.label {
		font-weight: 700;
	}
	h3 {
		margin: 1rem 0 0.35rem;
		font-size: 0.9375rem;
		text-wrap: balance;
	}
	ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding-block: 0.25rem;
		border-block-start: 2px dashed var(--rule);
		font-size: 0.9375rem;
		line-height: 1.4;
	}
	.name {
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.qty {
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.busiest {
		margin: 0.75rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.4;
		text-wrap: pretty;
	}
</style>
