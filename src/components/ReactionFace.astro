---
import type { ReactionKind } from "../comics/store.ts";

interface Props {
	kind: ReactionKind;
}

const { kind } = Astro.props;
---

<svg class="reaction-face" data-kind={kind} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
	{
		kind === "dead" && (
			<g class="skull">
				<path class="skin" d="M16 3C9 3 4.5 8 4.5 14c0 4 2 6.5 4.5 7.5V24h14v-2.5c2.5-1 4.5-3.5 4.5-7.5C27.5 8 23 3 16 3Z" />
				<ellipse class="dark" cx="11" cy="13.5" rx="3" ry="3.3" />
				<ellipse class="dark" cx="21" cy="13.5" rx="3" ry="3.3" />
				<path class="dark" d="M16 17l-1.6 3h3.2Z" />
				<g class="jaw">
					<path class="skin" d="M10 24h12v4q0 1.5-1.5 1.5h-9Q10 29.5 10 28Z" />
					<path class="thin" d="M13.5 24v5.5M16 24v5.5M18.5 24v5.5" />
				</g>
			</g>
		)
	}
	{
		kind === "mindblown" && (
			<>
				<path class="rays" d="M16 7V1.5M10.5 8 7.5 3.5M21.5 8l3-4.5M7 12 2.5 10M25 12l4.5-2" />
				<circle class="skin" cx="16" cy="19.5" r="11" />
				<path class="crack" d="M5.5 16.5 9 14l3 2 4-2.5 4 2.5 3-2 3.5 2.5" />
				<circle class="white" cx="11.5" cy="20" r="2.6" />
				<circle class="white" cx="20.5" cy="20" r="2.6" />
				<circle class="pupil" cx="11.5" cy="20" r="1" />
				<circle class="pupil" cx="20.5" cy="20" r="1" />
				<ellipse class="dark" cx="16" cy="26" rx="2" ry="2.2" />
			</>
		)
	}
	{
		kind === "tooreal" && (
			<>
				<g class="melt">
					<path
						class="skin"
						d="M4 16a12 12 0 0 1 24 0v6q0 3-2 3t-2-3v-1q0-2-2-2t-2 3v4q0 2.5-2 2.5t-2-2.5v-3q0-2-2-2t-2 2q0 2.5-2 2.5T4 23Z"
					/>
					<circle class="dark" cx="11" cy="13.5" r="1.7" />
					<circle class="dark" cx="21" cy="13.5" r="1.7" />
					<path class="feature" d="M11 18q5 3.5 10 0" />
				</g>
				<path class="drip" d="M16 28q-1.2 1.8-1.2 2.6a1.2 1.2 0 0 0 2.4 0q0-.8-1.2-2.6Z" />
			</>
		)
	}
	{
		kind === "groan" && (
			<>
				<circle class="skin" cx="16" cy="16" r="13" />
				<circle class="white" cx="11" cy="13" r="3.6" />
				<circle class="white" cx="21" cy="13" r="3.6" />
				<g class="roll">
					<circle class="pupil" cx="11" cy="11" r="1.6" />
					<circle class="pupil" cx="21" cy="11" r="1.6" />
				</g>
				<path class="feature" d="M11.5 23.5q4.5-1.5 9 .5" />
			</>
		)
	}
	{
		kind === "same" && (
			<>
				<ellipse class="white" cx="10" cy="16" rx="6.5" ry="9" />
				<ellipse class="white" cx="22" cy="16" rx="6.5" ry="9" />
				<g class="dart">
					<circle class="iris" cx="11.5" cy="17" r="3.4" />
					<circle class="iris" cx="23.5" cy="17" r="3.4" />
					<circle class="pupil" cx="11.5" cy="17" r="1.5" />
					<circle class="pupil" cx="23.5" cy="17" r="1.5" />
				</g>
			</>
		)
	}
	{
		kind === "fire" && (
			<g class="flame">
				<path class="outer" d="M16 30c-6.5 0-10-4.3-10-9.5 0-5 3.5-7.5 5-12 1.5 2.5 2.5 4 2.5 6 1.5-3 2-7 1-11 6 3 11.5 9 11.5 16.5 0 5.6-3.8 10-10 10Z" />
				<path class="skin" d="M16 30c-3 0-5-2-5-4.8 0-2.5 2-4 3-6.5 1 1.5 1.5 2.5 1.5 3.5 1-1.5 1.5-3 1.5-5 3 2 4 4.5 4 7.5 0 3.2-2 5.3-5 5.3Z" />
			</g>
		)
	}
</svg>

<style>
	/* Fills follow the theme: --highlight skin, --accent details, --on-highlight features (contrast-checked per theme);
	   --face/--on-face override them where the highlight is too dark for a face. */
	.reaction-face {
		--skin: var(--face, var(--highlight));
		--on-skin: var(--on-face, var(--on-highlight));
		display: block;
		inline-size: 1.6rem;
		block-size: 1.6rem;
		overflow: visible;
		fill: none;
		stroke: var(--ink);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.skin {
		fill: var(--skin);
	}
	.outer {
		fill: var(--accent);
	}
	.rays {
		stroke: var(--accent);
		stroke-width: 2.2;
	}
	.crack,
	.feature {
		stroke: var(--on-skin);
	}
	.thin {
		stroke: var(--on-skin);
		stroke-width: 1.2;
	}
	.dark {
		fill: var(--on-skin);
		stroke: none;
	}
	.drip {
		fill: var(--skin);
		stroke-width: 1.2;
	}
	/* Eyeballs stay white with a dark pupil in every theme, like the AQI faces. */
	.white {
		fill: #fff;
		stroke-width: 1.5;
	}
	.pupil {
		fill: #16201b;
		stroke: none;
	}
	.iris {
		fill: var(--accent);
		stroke: none;
	}
	.skull,
	.jaw,
	.melt,
	.flame,
	.rays {
		transform-box: fill-box;
	}
	.skull,
	.melt,
	.flame,
	.rays {
		transform-origin: 50% 100%;
	}

	/* Faces come alive on hover, while picked, and in the click burst. */
	@media (prefers-reduced-motion: no-preference) {
		:global(:is(button:hover, button:focus-visible, button[aria-pressed="true"], .comic-burst)) .skull {
			animation: cackle 0.5s ease-in-out infinite alternate;
		}
		:global(:is(button:hover, button:focus-visible, button[aria-pressed="true"], .comic-burst)) .jaw {
			animation: chatter 0.16s steps(2) infinite;
		}
		:global(:is(button:hover, button:focus-visible, button[aria-pressed="true"], .comic-burst)) .rays {
			animation: blast 0.9s ease-out infinite;
		}
		:global(:is(button:hover, button:focus-visible, button[aria-pressed="true"], .comic-burst)) .melt {
			animation: melt 2.4s ease-in-out infinite;
		}
		:global(:is(button:hover, button:focus-visible, button[aria-pressed="true"], .comic-burst)) .drip {
			animation: drip 1.6s ease-in infinite;
		}
		:global(:is(button:hover, button:focus-visible, button[aria-pressed="true"], .comic-burst)) .roll {
			animation: roll 1.8s ease-in-out infinite;
		}
		:global(:is(button:hover, button:focus-visible, button[aria-pressed="true"], .comic-burst)) .dart {
			animation: dart 1.4s steps(1) infinite;
		}
		:global(:is(button:hover, button:focus-visible, button[aria-pressed="true"], .comic-burst)) .flame {
			animation: flicker 0.6s ease-in-out infinite alternate;
		}
	}
	@keyframes cackle {
		from {
			rotate: -8deg;
		}
		to {
			rotate: 8deg;
		}
	}
	@keyframes chatter {
		to {
			translate: 0 1.8px;
		}
	}
	@keyframes blast {
		from {
			scale: 0.5;
			opacity: 0;
		}
		40% {
			opacity: 1;
		}
		to {
			scale: 1.25;
			opacity: 0;
		}
	}
	@keyframes melt {
		50% {
			scale: 1.06 0.9;
		}
	}
	@keyframes drip {
		from {
			translate: 0 -3px;
			opacity: 0;
		}
		30% {
			opacity: 1;
		}
		to {
			translate: 0 4px;
			opacity: 0;
		}
	}
	@keyframes roll {
		0%,
		100% {
			translate: 0 0;
		}
		25% {
			translate: 1.6px 0.6px;
		}
		50% {
			translate: 0 -0.6px;
		}
		75% {
			translate: -1.6px 0.6px;
		}
	}
	@keyframes dart {
		0% {
			translate: 0 0;
		}
		50% {
			translate: -3px 0;
		}
	}
	@keyframes flicker {
		from {
			transform: skewX(-4deg);
		}
		to {
			transform: scale(0.94, 1.08) skewX(4deg);
		}
	}
</style>
