---
import type { PortableTextBlock } from "emdash";
import { PortableText } from "emdash/ui";

interface Props {
	body: PortableTextBlock[] | undefined;
	/** Teaser mode: first block only, at most 5 lines, then a link here for the full text. */
	more?: string;
}

const { body, more } = Astro.props;
const shown = more ? body?.slice(0, 1) : body;
---

{
	shown?.length ? (
		<div class:list={["body", { teaser: !!more }]}>
			<PortableText value={shown} />
			{more && (
				<p class="more">
					<a href={more}>Read more →</a>
				</p>
			)}
		</div>
	) : null
}

<style>
	.body {
		max-width: 64ch;
		margin-block-start: 0.75rem;
		overflow-wrap: break-word;
	}
	.body :global(> :first-child) {
		margin-block-start: 0;
	}
	.body :global(> :last-child) {
		margin-block-end: 0;
	}
	.body :global(p) {
		margin-block: 0 0.75em;
		text-wrap: pretty;
	}
	.body :global(ul),
	.body :global(ol) {
		margin-block: 0 0.75em;
		padding-inline-start: 1.25em;
	}
	.teaser > :global(:first-child) {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 5;
		line-clamp: 5;
		overflow: hidden;
	}
	.more a {
		color: inherit;
		font-weight: 700;
	}
	.more a:focus-visible {
		outline: 3px solid var(--highlight);
		outline-offset: 2px;
	}
</style>
