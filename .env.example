# Copy to .env (untracked) and fill in. Office-specific values stay out of the public repo.

# Local dev: encrypts EmDash secrets in data/hub.db. Production keeps its own in /etc/hub/hub.env.
EMDASH_ENCRYPTION_KEY=

# deploy.sh and infra/create-*-ct.sh (copy this file next to the scripts on the Proxmox host).
# Internal domain the gateway serves: https://<ct>.OFFICE_DOMAIN; the hub is https://hub.OFFICE_DOMAIN.
OFFICE_DOMAIN=office.lan
# SSH target for deploy.sh.
HUB_HOST=root@hub.lxc
# create-ai-ct.sh: the only address allowed to reach the AI ports.
HUB_IP=
# GitHub users whose public SSH keys new containers trust, space-separated.
SSH_KEY_GITHUB_USERS=
