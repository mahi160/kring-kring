{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Starter",
		"description": "A minimal EmDash starter with posts and pages",
		"author": "EmDash"
	},
	"settings": {
		"title": "Office Hub",
		"tagline": "News and announcements for the office"
	},
	"collections": [
		{
			"slug": "announcements",
			"label": "Announcements",
			"labelSingular": "Announcement",
			"icon": "megaphone",
			"routable": false,
			"sortOrder": 1,
			"supports": ["drafts", "revisions"],
			"admin": { "listColumns": ["title", "pinned", "expires_at"] },
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true
				},
				{
					"slug": "body",
					"label": "Body",
					"type": "portableText"
				},
				{
					"slug": "pinned",
					"label": "Pinned",
					"type": "boolean",
					"defaultValue": false,
					"indexed": true
				},
				{
					"slug": "expires_at",
					"label": "Expires at",
					"type": "datetime",
					"indexed": true
				}
			]
		},
		{
			"slug": "events",
			"label": "Events",
			"labelSingular": "Event",
			"icon": "calendar",
			"routable": false,
			"sortOrder": 2,
			"supports": ["drafts", "revisions"],
			"admin": { "listColumns": ["title", "starts_at", "location"] },
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true
				},
				{
					"slug": "starts_at",
					"label": "Starts at",
					"type": "datetime",
					"required": true,
					"indexed": true
				},
				{
					"slug": "ends_at",
					"label": "Ends at",
					"type": "datetime"
				},
				{
					"slug": "location",
					"label": "Location",
					"type": "string"
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "text"
				}
			]
		},
		{
			"slug": "people",
			"label": "People",
			"labelSingular": "Person",
			"description": "Everyone at the office. The single source for staff identity.",
			"icon": "users",
			"routable": false,
			"sortOrder": 3,
			"supports": ["drafts", "revisions"],
			"titleField": "name",
			"admin": { "listColumns": ["name", "team", "active", "birthday_month"] },
			"fields": [
				{
					"slug": "name",
					"label": "Name",
					"type": "string",
					"required": true
				},
				{
					"slug": "preferred_name",
					"label": "Preferred name (shown on the hub instead of the full name)",
					"type": "string"
				},
				{
					"slug": "team",
					"label": "Team",
					"type": "string"
				},
				{
					"slug": "designation",
					"label": "Designation",
					"type": "string"
				},
				{
					"slug": "photo",
					"label": "Photo",
					"type": "image"
				},
				{
					"slug": "birthday_month",
					"label": "Birthday month",
					"type": "select",
					"validation": {
						"options": [
							"January",
							"February",
							"March",
							"April",
							"May",
							"June",
							"July",
							"August",
							"September",
							"October",
							"November",
							"December"
						]
					}
				},
				{
					"slug": "birthday_day",
					"label": "Birthday day",
					"type": "integer",
					"validation": { "min": 1, "max": 31 }
				},
				{
					"slug": "hide_birthday",
					"label": "Hide birthday on the hub",
					"type": "boolean",
					"defaultValue": false
				},
				{
					"slug": "joined_on",
					"label": "Joined on",
					"type": "datetime"
				},
				{
					"slug": "phone",
					"label": "Phone",
					"type": "string"
				},
				{
					"slug": "email",
					"label": "Email",
					"type": "string"
				},
				{
					"slug": "slack",
					"label": "Slack name",
					"type": "string"
				},
				{
					"slug": "github",
					"label": "GitHub username",
					"type": "string"
				},
				{
					"slug": "blood_group",
					"label": "Blood group",
					"type": "select",
					"validation": { "options": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"] }
				},
				{
					"slug": "emergency_name",
					"label": "Emergency contact name",
					"type": "string"
				},
				{
					"slug": "emergency_relation",
					"label": "Emergency contact relation",
					"type": "string"
				},
				{
					"slug": "emergency_phone",
					"label": "Emergency contact phone",
					"type": "string"
				},
				{
					"slug": "bio",
					"label": "Short bio",
					"type": "text",
					"validation": { "maxLength": 280 }
				},
				{
					"slug": "active",
					"label": "Currently works here",
					"type": "boolean",
					"defaultValue": true
				}
			]
		},
		{
			"slug": "quiz_questions",
			"label": "Quiz questions",
			"labelSingular": "Quiz question",
			"description": "The daily quiz bank. Each working day (Sun–Thu) one published, approved question runs 10:00–18:00; unused questions go first, oldest first.",
			"icon": "trophy",
			"routable": false,
			"sortOrder": 4,
			"supports": ["drafts", "revisions"],
			"titleField": "question",
			"admin": { "listColumns": ["question", "approved"] },
			"fields": [
				{
					"slug": "question",
					"label": "Question",
					"type": "string",
					"required": true
				},
				{
					"slug": "choices",
					"label": "Choices (2 to 4)",
					"type": "repeater",
					"required": true,
					"validation": {
						"minItems": 2,
						"maxItems": 4,
						"subFields": [{ "slug": "label", "label": "Choice", "type": "string", "required": true }]
					}
				},
				{
					"slug": "correct_choice",
					"label": "Correct choice (1 = first)",
					"type": "integer",
					"required": true,
					"validation": { "min": 1, "max": 4 }
				},
				{
					"slug": "explanation",
					"label": "Explanation (shown after 18:00)",
					"type": "text"
				},
				{
					"slug": "approved",
					"label": "Approved for the quiz",
					"type": "boolean",
					"defaultValue": false
				}
			]
		},
		{
			"slug": "handbook",
			"label": "Handbook",
			"labelSingular": "Handbook page",
			"description": "The office code book: rules, policies and how-tos, shown at /handbook.",
			"icon": "book",
			"urlPattern": "/handbook/{slug}",
			"sortOrder": 5,
			"supports": ["drafts", "revisions"],
			"admin": { "listColumns": ["title", "topic", "order"] },
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true
				},
				{
					"slug": "topic",
					"label": "Topic",
					"type": "select",
					"required": true,
					"indexed": true,
					"validation": {
						"options": [
							"Office basics",
							"Working hours & leave",
							"Tech & accounts",
							"Kitchen & tea",
							"Safety",
							"Culture"
						]
					}
				},
				{
					"slug": "order",
					"label": "Order within topic (lowest first)",
					"type": "integer"
				},
				{
					"slug": "summary",
					"label": "Summary (one line, shown in the contents)",
					"type": "text",
					"validation": { "maxLength": 160 }
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"required": true
				}
			]
		},
		{
			"slug": "gallery",
			"label": "Gallery",
			"labelSingular": "Photo",
			"description": "Office photos shown on the wall at /gallery. Staff can add photos there too; delete unwanted ones here.",
			"icon": "image",
			"routable": false,
			"sortOrder": 6,
			"supports": ["drafts", "revisions"],
			"admin": { "listColumns": ["caption", "uploaded_by", "featured"] },
			"fields": [
				{
					"slug": "photo",
					"label": "Photo",
					"type": "image",
					"required": true
				},
				{
					"slug": "caption",
					"label": "Caption",
					"type": "string",
					"validation": { "maxLength": 140 }
				},
				{
					"slug": "uploaded_by",
					"label": "Shared by (name)",
					"type": "string"
				},
				{
					"slug": "featured",
					"label": "Show big on the wall",
					"type": "boolean",
					"defaultValue": false
				}
			]
		},
		{
			"slug": "holidays",
			"label": "Holidays",
			"labelSingular": "Holiday",
			"description": "Office holidays shown at /holidays and as the next-holiday chip on the home page. Add one entry per day off; consecutive days with the same title show as one holiday.",
			"icon": "calendar",
			"routable": false,
			"sortOrder": 7,
			"supports": ["drafts", "revisions"],
			"admin": {
				"listColumns": ["title", "date", "tentative"]
			},
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true
				},
				{
					"slug": "date",
					"label": "Date",
					"type": "datetime",
					"required": true,
					"indexed": true
				},
				{
					"slug": "tentative",
					"label": "Subject to the appearance of the moon",
					"type": "boolean",
					"defaultValue": false
				}
			]
		},
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"urlPattern": "/posts/{slug}",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
